{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0",
    "npm": ">=11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "node site.mjs && node serve.mjs",
    "build": "node site.mjs",
    "import-bundle": "node import-live.mjs",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude=\"test/**\"",
    "lint": "eslint .",
    "check": "node scripts/check-syntax.mjs && npm run build && npm test",
    "smoke": "node --test --test-name-pattern=smoke"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "globals": "17.12.0"
  }
}
